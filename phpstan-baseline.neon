parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$string of function rtrim expects string, bool\|string given\.$#'
			identifier: argument.type
			count: 1
			path: config/filesystems.php

		-
			message: '#^Cannot call method equalTo\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Feature/CustomerTest.php

		-
			message: '#^Unable to resolve the template type TValue in call to function expect$#'
			identifier: argument.templateType
			count: 1
			path: tests/Feature/CustomerTest.php
